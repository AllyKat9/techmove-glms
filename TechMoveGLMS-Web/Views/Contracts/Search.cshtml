@model IEnumerable<ContractResponseDto>
@using TechMoveGLMS_Web.Data.DTOs
@using TechMoveGLMS_Web.Models
@using TechMoveGLMS_Web.Models

<h2>Search Contracts</h2>

<div class="card mb-4">
    <div class="card-body">
        <form method="get" asp-action="Search">
            <div class="row">
                <div class="col-md-3">
                    <label class="form-label">Start Date From:</label>
                    <input type="date" name="startDate" value="@ViewBag.StartDate" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">End Date To:</label>
                    <input type="date" name="endDate" value="@ViewBag.EndDate" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Status:</label>
                    <select name="status" class="form-control" asp-items="Html.GetEnumSelectList<ContractStatus>()">
                        <option value="">-- All --</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">&nbsp;</label>
                    <button type="submit" class="btn btn-primary form-control">🔍 Search</button>
                </div>
            </div>
        </form>
    </div>
</div>

@if (Model.Any())
{
    <table class="table table-striped">
        <thead class="table-dark">
            <tr>
                <th>Client</th>
                <th>Start Date</th>
                <th>End Date</th>
                <th>Status</th>
                <th>Service Level</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.ClientName</td>
                    <td>@item.StartDate.ToShortDateString()</td>
                    <td>@item.EndDate.ToShortDateString()</td>
                    <td>
                        @if (item.Status == ContractStatus.Active)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else if (item.Status == ContractStatus.Expired)
                        {
                            <span class="badge bg-danger">Expired</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">@item.Status</span>
                        }
                    </td>
                    <td>@item.ServiceLevel</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">View</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-warning">No contracts found matching your criteria.</div>
}

<a asp-action="Index" class="btn btn-secondary">Back to All Contracts</a>
